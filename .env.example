# Backend settings (copy to backend/.env)
DEMO_MODE=true
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
FRONTEND_URL=
URL_REPUTATION_API_KEY=

# Frontend settings (copy to frontend/.env)
# Leave empty for the local Vite proxy; set to the Render URL in Vercel.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Development-only local demo access when Supabase credentials are absent.
VITE_DEMO_MODE=true
